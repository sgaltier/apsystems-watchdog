# =============================================================================
# Configuration — renommez ce fichier en "config.env" puis remplissez-le.
#
# ATTENTION : ce fichier contient des secrets.
#   chmod 600 config.env
#
# Syntaxe env_file : PAS de "export", PAS de guillemets, PAS d'espace autour
# du signe égal. Écrivez  CLE=valeur  et rien d'autre.
# =============================================================================

# --- Identifiants OpenAPI APsystems (à demander par e-mail au support) -------
APS_APP_ID=
APS_APP_SECRET=
APS_SID=

# Si vous obtenez systématiquement l'erreur 3002 (signature invalide),
# décommentez la ligne suivante pour signer le chemin complet.
#APS_SIGN_FULL_PATH=1

# --- Localisation (calcul de la hauteur du soleil) ---------------------------
PV_LAT=45.75
PV_LON=4.85

# --- Notifications : au moins un canal ---------------------------------------

# ntfy.sh — le plus simple, aucun compte requis.
# Générez un sujet imprévisible :  openssl rand -hex 8
NTFY_TOPIC=

# Telegram (facultatif)
#TELEGRAM_TOKEN=
#TELEGRAM_CHAT_ID=

# E-mail via Gmail (facultatif) — SMTP_PASS = mot de passe d'application
# 16 caractères, sans espaces, généré sur myaccount.google.com/apppasswords
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=votre.adresse@gmail.com
#SMTP_PASS=
#SMTP_FROM=votre.adresse@gmail.com
#SMTP_TO=votre.adresse@gmail.com

# --- Dead man's switch (fortement recommandé) --------------------------------
# Crée un check sur healthchecks.io avec une période de 30 min et un délai de
# grâce de 90 min : vous serez prévenu si le NAS, la box ou le conteneur meurt.
#HEALTHCHECKS_URL=

# --- Réglages de détection ---------------------------------------------------
PV_MIN_ELEVATION=10
PV_MIN_POWER_W=20
PV_GRACE_MINUTES=60

# Quota d'appels épuisé (code 2005) : heure locale de l'unique tentative
# quotidienne pendant la mise en veille. Défaut 12 (midi).
#PV_QUOTA_PROBE_HOUR=12
